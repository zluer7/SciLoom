{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SciLoom",
  "version": "0.1.0",
  "identifier": "local.labpod.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SciLoom",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "closable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../demo/west-lake-vinegar-fish/project-import.json": "demo/west-lake-vinegar-fish/project-import.json",
      "../docs/QUICK_START.md": "docs/QUICK_START.md"
    }
  }
}
